// Part 2 added endpoints, event types, and subscriptions; Part 3 added events
// and deliveries; Part 4 added delivery attempts and the claim/lease columns;
// Part 5 adds retry scheduling (nextAttemptAt and its index). Nothing here is
// added before the part that actually reads or writes it
// (IMPLEMENTATION_PLAN.md section 2, "Schema evolution across parts").
//
// Part 5 deliberately adds NO automatic-attempt-budget column. The budget is
// derived by counting persisted DeliveryAttempt rows for the delivery, which
// is the only count that means "requests this receiver actually saw" — see the
// attemptCount comment on Delivery below. A stored counter would be a second,
// redundant source of truth that nothing reads.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// D1 (IMPLEMENTATION_PLAN.md section 3): event types are a small persisted,
// seeded catalog (see prisma/seed.ts) rather than a public CRUD resource.
// Persisting them gives foreign-key integrity for subscriptions and makes
// the unique (endpoint, eventType) constraint below expressible in the
// database instead of only in application code.
model EventType {
  id            String         @id @default(uuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  events        Event[]
}

model WebhookEndpoint {
  id            String         @id @default(uuid())
  name          String
  url           String
  // CSPRNG-generated at creation (crypto.randomBytes), never returned by any
  // API response and never selected by a query that feeds a response.
  signingSecret String
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  deliveries    Delivery[]
}

// Deleting a WebhookEndpoint cascades to its Subscriptions: a subscription
// without its endpoint is meaningless, so onDelete: Cascade on the endpoint
// relation is the single, consistent rule for what happens to them.
model Subscription {
  id          String   @id @default(uuid())
  endpointId  String
  eventTypeId String
  createdAt   DateTime @default(now())

  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType EventType       @relation(fields: [eventTypeId], references: [id])

  // Database-enforced: a duplicate (endpoint, eventType) subscription must
  // fail at the constraint, not only at an application-level pre-check.
  @@unique([endpointId, eventTypeId])
}

// An event published to the platform (SPEC.md section 6). The payload is
// persisted before any delivery is attempted; the worker reads it from here,
// never from the request.
model Event {
  id             String   @id @default(uuid())
  eventTypeId    String
  payload        Json
  // D2 (IMPLEMENTATION_PLAN.md section 3): the caller-supplied
  // `Idempotency-Key`, unique across events when present. PostgreSQL treats
  // NULLs as distinct in a unique index, so a plain @unique on a nullable
  // column is behaviourally identical to the partial unique index
  // `WHERE "idempotencyKey" IS NOT NULL` that D2 names — unlimited rows may
  // omit the key, and at most one row may hold any given key — while staying
  // expressible in Prisma without schema/migration drift.
  idempotencyKey String?  @unique
  // SHA-256 of the canonically serialized {type, payload} of the publishing
  // request, written only when an idempotency key is present. D2 has to tell
  // a replay of the same request from a reuse of the key for a materially
  // different one; comparing this fingerprint is more robust than deep-
  // comparing a jsonb round-trip, whose key order and number formatting are
  // not guaranteed to match the original request bytes.
  requestHash    String?
  createdAt      DateTime @default(now())

  eventType  EventType  @relation(fields: [eventTypeId], references: [id])
  deliveries Delivery[]
}

// All five states from SPEC.md section 6 are defined here, at the point the
// enum is created, because the value set is specified rather than inferred
// (IMPLEMENTATION_PLAN.md section 2, the one deliberate exception to
// migrating only what the current part uses). Part 3 only ever writes
// PENDING; the remaining transitions arrive with the worker in Parts 4-5.
enum DeliveryState {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  DELIVERED
  FAILED
}

// How one outbound attempt ended (SPEC.md section 6, D3 in
// IMPLEMENTATION_PLAN.md section 3). SUCCESS is 2xx. The failure values carry
// the retryable/permanent classification of D3, recorded faithfully here even
// though Part 4 sends both to FAILED, so Part 5 changes only the branch that
// reads this and never the attempt history it inherits.
enum DeliveryAttemptOutcome {
  SUCCESS
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

// How the attempt failed mechanically, independent of whether that failure is
// retryable. Null on a successful attempt.
enum DeliveryErrorCategory {
  HTTP_STATUS
  TIMEOUT
  CONNECTION_ERROR
}

// The intended delivery of one event to one endpoint (SPEC.md section 6).
model Delivery {
  id         String        @id @default(uuid())
  eventId    String
  endpointId String
  state      DeliveryState @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Counts CLAIMS, not attempts, and mints DeliveryAttempt.attemptNumber.
  //
  // It is incremented by the claim query itself
  // (src/worker/delivery-claiming.ts) rather than derived from a COUNT over
  // DeliveryAttempt. The claim is the one statement that grants exclusive
  // ownership of the row, so assigning the number there makes it impossible
  // for two workers to mint the same one. The value is monotonic and never
  // decreases.
  //
  // Because every claim increments it, it can exceed the number of
  // DeliveryAttempt rows. A claim leaves no attempt row when no request was
  // made — a disabled endpoint or an unsafe URL (both terminal, so the gap is
  // inert) — and also when the process or the database fails between the claim
  // and the attempt being written, which is NOT terminal: Part 5 will reclaim
  // that row having already consumed a number.
  //
  // The numbering gaps are harmless: attempt numbers only have to be unique
  // and increasing. But this column is therefore NOT a count of attempts, and
  // the automatic-attempt budget is counted from DeliveryAttempt rows rather
  // than read from here — otherwise a receiver's retry budget could be
  // exhausted by platform-side failures it never saw.
  //
  // It is also the worker's fencing token: because the claim mints each value
  // exactly once, "attemptCount = the number I was granted" identifies the
  // current owner of the row, and every worker-driven state transition is
  // guarded on it (src/modules/deliveries/state-transitions.ts).
  attemptCount Int @default(0)

  // Processing lease (ARCHITECTURE.md section 11). Written by the claim and
  // left in place afterwards as last-claim metadata: eligibility is decided by
  // `state` (and, from Part 5, nextAttemptAt), so stale values on a terminal
  // row are inert. Lease duration is derived from the delivery timeout in
  // app/config.ts and is always strictly longer than it.
  claimedAt  DateTime?
  leaseUntil DateTime?

  // When a RETRY_SCHEDULED delivery next becomes eligible (ARCHITECTURE.md
  // section 14, SPEC.md section 6). Database-backed rather than an in-process
  // timer, so a restart loses no scheduled retry. Written by the retry branch
  // of the state transitions and by the lease recovery sweep; cleared by the
  // claim, so it is null whenever the delivery is not waiting for a retry.
  nextAttemptAt DateTime?

  // Set when the delivery reaches a terminal state, DELIVERED or FAILED
  // ("completion/failure timestamps where applicable", SPEC.md section 6).
  completedAt DateTime?
  // A short, safe explanation of a FAILED delivery. Generated by the platform,
  // never copied from a receiver response body, and never containing a secret.
  failureReason String?

  // Both parents cascade. An event's deliveries are meaningless without the
  // event, and deleting an endpoint already cascades to its subscriptions
  // (the documented Part 2 rule); restricting instead would make an endpoint
  // undeletable as soon as it had one delivery, silently breaking that rule.
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts DeliveryAttempt[]

  // Database-enforced: one event produces at most one delivery per endpoint.
  // If publication were ever retried or raced, a duplicate fan-out would send
  // the same webhook twice, so the invariant belongs in PostgreSQL and not
  // only in the fan-out code. Its leading column also serves the
  // "deliveries of this event" read below, so no separate eventId index.
  @@unique([eventId, endpointId])
  // Justified by endpoint deletion: the cascade above makes PostgreSQL look
  // up referencing deliveries by endpointId, which would otherwise be a
  // sequential scan of a table that only grows.
  @@index([endpointId])
  // Serves the PENDING half of the worker's claim query and the lease recovery
  // sweep's `state = 'PROCESSING'` scan. Without a state-leading index every
  // poll — several per second — sequentially scans a table that only grows.
  // Recovery additionally filters on leaseUntil, deliberately left to a filter
  // rather than given a third index: PROCESSING rows are bounded by the
  // in-flight work of the running workers, so the state prefix alone already
  // reduces that scan to a handful of rows.
  @@index([state, createdAt])
  // Serves the retry half of the same claim query,
  // `state = 'RETRY_SCHEDULED' AND "nextAttemptAt" <= now()`. Putting the due
  // time in the second column makes that a range scan; with only
  // ([state, createdAt]) available the poll would read and filter every
  // scheduled retry, including the ones not yet due — exactly the set that
  // grows during a receiver outage.
  @@index([state, nextAttemptAt])
}

// One actual outbound HTTP attempt (SPEC.md section 6, ARCHITECTURE.md
// section 17). Exactly one row per request that left the process — success,
// HTTP error, timeout, and connection failure alike. A delivery that is
// abandoned before any request is sent (disabled endpoint, unsafe URL)
// deliberately produces no row here.
//
// Nothing sensitive is stored: no signing secret, no signature, no request
// payload, and no receiver response body. `errorMessage` is a short string
// generated by this platform, not echoed from the receiver.
model DeliveryAttempt {
  id             String                 @id @default(uuid())
  deliveryId     String
  attemptNumber  Int
  attemptedAt    DateTime
  outcome        DeliveryAttemptOutcome
  httpStatusCode Int?
  durationMs     Int
  errorCategory  DeliveryErrorCategory?
  errorMessage   String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  // Database-enforced: attempt numbers are unique within a delivery. Attempt
  // miscounting is a listed project risk, and this turns a numbering bug into
  // a constraint violation instead of a silently corrupted history. The
  // leading column also serves "the attempts of this delivery" reads, so no
  // separate deliveryId index.
  @@unique([deliveryId, attemptNumber])
}
