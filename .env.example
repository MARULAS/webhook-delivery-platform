# Copy this file to .env and adjust values for your local environment.
# .env is gitignored and must never be committed.

# PostgreSQL connection string. Required, no default.
# Matches the credentials and database name in docker-compose.yml.
# For running tests against a separate database, point this at
# "webhooks_test" instead of "webhooks" (create it once with:
#   docker compose exec postgres createdb -U webhooks webhooks_test
# ).
DATABASE_URL="postgresql://webhooks:webhooks@localhost:5433/webhooks?schema=public"

# HTTP port the Fastify server listens on. Optional, defaults to 3000.
PORT=3000

# Pino log level (fatal, error, warn, info, debug, trace, silent). Optional, defaults to info.
LOG_LEVEL=info

# Application environment: development, test, or production. Optional, defaults to development.
NODE_ENV=development

# Development-only SSRF exemption (D5, docs/IMPLEMENTATION_PLAN.md section 3).
# When "true", the URL safety module (src/infrastructure/security/url-safety.ts)
# accepts loopback destinations (localhost, 127.0.0.0/8, ::1) so a local test
# receiver can be registered as a webhook endpoint. Optional, defaults to
# false. It is structurally impossible for this to take effect when
# NODE_ENV=production: setting both aborts startup, and the URL safety module
# never consults this flag under production configuration regardless.
ALLOW_LOCAL_ENDPOINTS=false

# --- Delivery worker (Part 4) ---

# Whether the background delivery worker runs inside this process. Optional,
# defaults to true. Set to "false" to run the API without delivering (the
# integration tests do this so they can drive the worker one iteration at a
# time); deliveries then simply accumulate in PENDING until a worker runs.
WORKER_ENABLED=true

# How long the worker waits before polling again after finding no eligible
# delivery. It polls again immediately after a non-empty batch. Milliseconds,
# optional, defaults to 1000.
WORKER_POLL_INTERVAL_MS=1000

# Maximum outbound webhook requests in flight at once (ARCHITECTURE.md
# section 12). Optional, defaults to 5.
WORKER_CONCURRENCY=5

# How many deliveries one claim takes in a single atomic statement. Optional,
# defaults to 20. Larger values amortize the claim over more work; the
# processing lease is derived to cover the resulting queueing time.
WORKER_BATCH_SIZE=20

# Hard timeout for one outbound webhook request, in milliseconds. A receiver
# must not be able to occupy a worker indefinitely (SPEC.md section 9).
# Optional, defaults to 10000.
#
# The processing lease is NOT configurable: it is derived from this value
# together with the batch size and concurrency (see src/app/config.ts). One
# lease is stamped for a whole claimed batch, so the derivation covers every
# delivery a single pool slot must work through in sequence — each one costing
# a full timeout plus its own database work — and not just one request. A
# lease that expired while a delivery was still in flight would let a second
# worker reclaim it and send the same webhook twice.
DELIVERY_TIMEOUT_MS=10000

# --- Retry and recovery (Part 5) ---

# Maximum automatic attempts per delivery, counting the first one (SPEC.md
# section 10). Optional, defaults to 5: one initial delivery plus four
# automatic retries. Once this many DeliveryAttempt rows exist for a delivery,
# a further retryable failure ends it in FAILED instead of RETRY_SCHEDULED.
# The budget counts persisted attempts — requests that actually left the
# process — so a platform-side failure the receiver never saw does not consume
# it. Manual retry (Part 6) is separate and is not limited by this value.
MAX_DELIVERY_ATTEMPTS=5

# Base delay of the bounded exponential backoff, in milliseconds. Optional,
# defaults to 1000. The delay after attempt N is
# min(RETRY_BASE_DELAY_MS * 2^(N-1), RETRY_MAX_DELAY_MS), so the defaults give
# 1s, 2s, 4s, 8s.
RETRY_BASE_DELAY_MS=1000

# Ceiling the backoff saturates at, in milliseconds. Optional, defaults to
# 60000. Must be greater than or equal to RETRY_BASE_DELAY_MS; startup fails if
# it is not.
RETRY_MAX_DELAY_MS=60000

# How long shutdown waits for the in-flight worker iteration to finish after
# it stops claiming, in milliseconds. Optional, defaults to 10000; 0 means do
# not wait. The window is bounded on purpose — a delivery that does not finish
# inside it stays PROCESSING and is recovered when its lease expires, so
# correctness never depends on shutdown succeeding (ARCHITECTURE.md section 31).
WORKER_SHUTDOWN_GRACE_MS=10000
